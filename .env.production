# ============================================
# Naked Forex API - Production Configuration
# ============================================
# This is a template for production deployment on VPS
# Copy this file to .env and update with your production values
#
# SETUP INSTRUCTIONS:
# 1. cp .env.production .env
# 2. Update the critical values below marked with "IMPORTANT"
# 3. Run: ./deployment/deploy.sh

# ============================================
# Application Settings
# ============================================
APP_NAME=Naked Forex API
APP_VERSION=0.1.0
DEBUG=false

# API Configuration
API_PREFIX=/api/v1
# Update with your frontend URL if applicable
CORS_ORIGINS=["http://localhost:8000"]

# ============================================
# Database (Neon PostgreSQL)
# ============================================
# IMPORTANT: Use Neon connection string here
# Format: postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/neondb?ssl=require
# Get this from your Neon dashboard
POSTGRES_URL=postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/neondb?ssl=require

# Fallback (not recommended for production)
DATABASE_URL=sqlite+aiosqlite:///./naked_forex.db

# ============================================
# Authentication
# ============================================
# IMPORTANT: Generate a secure secret key!
# Run: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_GENERATE_SECURE_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============================================
# Discord Bot Configuration
# ============================================
# IMPORTANT: Get your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
# IMPORTANT: Channel ID where alerts will be sent (right-click channel → Copy ID)
DISCORD_CHANNEL_ID=0
# Interval between automatic signal scans in minutes
SCAN_INTERVAL_MINUTES=60

# ============================================
# Trading Parameters
# ============================================
DEFAULT_TICKERS=["EURUSD=X", "USDJPY=X", "GBPUSD=X", "USDCHF=X", "AUDUSD=X", "USDCAD=X", "NZDUSD=X", "EURGBP=X", "EURJPY=X", "GBPJPY=X"]
DEFAULT_TIMEFRAME=15m
LOOKBACK_BARS=500
SR_SENSITIVITY=0.05
WICK_RATIO=3.0
RR_TARGET=1.0

# Risk Management
MAX_RISK_PER_TRADE=0.02
RISK_FREE_RATE=0.02

# Zone Detection
FRESH_ZONE_THRESHOLD=100
MIN_PIVOT_LOOKBACK=5
MIN_ZONE_TOUCHES=2

# Pattern Detection
MANUAL_EXIT_BARS=5
THREE_PULSE_TOLERANCE=5

# ============================================
# Data Source
# ============================================
YFINANCE_CACHE_DIR=./cache

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ============================================
# Rate Limiting (Optional)
# ============================================
ENABLE_RATE_LIMIT=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
