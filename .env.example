# ============================================
# Naked Forex API - Environment Configuration
# ============================================
# Copy this file to .env and update with your values

# ============================================
# Application Settings
# ============================================
APP_NAME=Naked Forex API
APP_VERSION=0.1.0
DEBUG=false

# API Configuration
API_PREFIX=/api/v1
# CORS_ORIGINS should be a JSON array of allowed URLs
CORS_ORIGINS=["http://localhost:3000","http://localhost:8100"]

# ============================================
# Data Source Configuration
# ============================================
# Directory for caching yfinance data
YFINANCE_CACHE_DIR=./cache
# Default tickers to monitor (comma-separated or JSON array)
DEFAULT_TICKERS = ["EURUSD=X", "USDJPY=X", "GBPUSD=X", "USDCHF=X", "AUDUSD=X", "USDCAD=X", "NZDUSD=X", "EURGBP=X", "EURJPY=X", "GBPJPY=X", "EURCHF=X", "AUDJPY=X", "GBPAUD=X", "EURAUD=X", "GC=F", "BTC-USD", "^SPX", "^NDX"]

# ============================================
# Trading Parameters
# ============================================
# Default chart timeframe (1m, 5m, 15m, 30m, 1h, 4h, 1d)
DEFAULT_TIMEFRAME=15m
# Number of bars to analyze (100-2000)
LOOKBACK_BARS=500
# S/R zone sensitivity (0.01-0.2, where 0.05 = 5%)
SR_SENSITIVITY=0.05
# Minimum wick-to-body ratio for Big Wick (2.0-10.0)
WICK_RATIO=3.0
# Default risk-reward ratio (0.5-5.0, where 1.0 = 1:1)
RR_TARGET=1.0

# ============================================
# Risk Management
# ============================================
# Maximum risk per trade as fraction of capital (0.005-0.1, where 0.02 = 2%)
MAX_RISK_PER_TRADE=0.02
# Risk-free rate for Sharpe ratio calculation
RISK_FREE_RATE=0.02

# ============================================
# Zone Detection Parameters
# ============================================
# Bars since last touch to consider zone fresh (10-500)
FRESH_ZONE_THRESHOLD=100
# Lookback period for pivot point detection (3-20)
MIN_PIVOT_LOOKBACK=5
# Minimum touches to qualify as a zone (1-10)
MIN_ZONE_TOUCHES=2

# ============================================
# Pattern Detection Parameters
# ============================================
# Bars of consolidation before suggesting manual exit (3-20)
MANUAL_EXIT_BARS=5
# Maximum bar difference for three-pulse detection (1-20)
THREE_PULSE_TOLERANCE=5

# ============================================
# Database
# ============================================
# PostgreSQL database URL (recommended for production)
# Format: postgresql+asyncpg://user:password@host:port/database?ssl=require
# For Neon: Use ?ssl=require (NOT sslmode=require - asyncpg uses different parameter names)
# Example: postgresql+asyncpg://finance_user:your_password@localhost:5432/finance_db?ssl=require
POSTGRES_URL=postgresql+asyncpg://user:password@localhost:5432/finance_db?ssl=require

# SQLite database URL (fallback, for development only)
DATABASE_URL=sqlite+aiosqlite:///./naked_forex.db

# ============================================
# Authentication (JWT)
# ============================================
# IMPORTANT: Generate a secure secret key for production!
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_USE_PYTHON_SECRETS
# JWT algorithm
ALGORITHM=HS256
# Token expiration time in minutes (default: 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============================================
# Discord Bot Configuration
# ============================================
# Get your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
# Channel ID where alerts will be sent
DISCORD_CHANNEL_ID=0
# Interval between automatic signal scans in minutes (1-60)
SCAN_INTERVAL_MINUTES=15

# ============================================
# Logging
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Log file path
LOG_FILE=logs/app.log

# ============================================
# Rate Limiting (Optional)
# ============================================
# Enable rate limiting for API endpoints
ENABLE_RATE_LIMIT=false
# Max requests per time window
RATE_LIMIT_REQUESTS=100
# Time window in seconds
RATE_LIMIT_WINDOW_SECONDS=60
